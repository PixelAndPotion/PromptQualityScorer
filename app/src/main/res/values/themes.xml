<?xml version="1.0" ?>
<resources>
    <style
        name="Base.Theme.Test_Application"
        parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/purple_light</item>
        <item name="colorOnPrimaryContainer">@color/purple</item>
        <item name="colorSecondary">@color/purple</item>
        <item name="colorSurface">@color/page</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/nav_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style
        name="Theme.Test_Application"
        parent="Base.Theme.Test_Application" />
    <style
        name="AppButton"
        parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style
        name="AppButton.Outlined"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/purple</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="ScreenHeading">
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="BodyText">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="IconButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="tint">@color/ink</item>
    </style>
</resources>
