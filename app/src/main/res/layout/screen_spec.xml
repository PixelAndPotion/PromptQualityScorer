<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/backSpec"
            style="@style/IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />
        <TextView
            style="@style/ScreenHeading"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/spec_title"
            android:textSize="19sp" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="9dp"
                app:strokeColor="@color/green"
                app:strokeWidth="1dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/green_light">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/specScoreLabel"
                            style="@style/BodyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/spec_ready"
                            android:textColor="@color/green"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/specScoreValue"
                            style="@style/BodyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/spec_unscored"
                            android:textColor="@color/green"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:padding="14dp"
                        android:background="@drawable/success_ring"
                        app:srcCompat="@drawable/ic_check"
                        app:tint="@color/green"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/textSpec"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textIsSelectable="true"
                android:lineSpacingExtra="5dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopy"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copy_spec"
                android:layout_marginTop="24dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditPrompt"
                style="@style/AppButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edit_prompt"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
