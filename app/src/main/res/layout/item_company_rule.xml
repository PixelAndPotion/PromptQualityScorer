<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="10dp"
    app:strokeColor="@color/purple"
    app:strokeWidth="1dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/purple_light">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/textRuleTitle"
                style="@style/BodyText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textStyle="bold" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.MaterialComponents.CompoundButton.Switch"
                app:thumbTint="@color/white"
                app:trackTint="@color/switch_track"
                android:minWidth="48dp"
                android:id="@+id/switchEnabled"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/textRuleDesc"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnDeleteRule"
            style="@style/IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/delete_rule" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
