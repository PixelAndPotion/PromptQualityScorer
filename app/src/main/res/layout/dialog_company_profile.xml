<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView
            style="@style/ScreenHeading"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/company_title"
            android:textSize="18sp" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnCloseRules"
            style="@style/IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close" />
    </LinearLayout>
    <TextView
        android:id="@+id/companyIntro"
        style="@style/BodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/company_intro"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp" />
    <TextView
        android:id="@+id/emptyRules"
        style="@style/BodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/empty_rules"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCompanyRules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="80dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddRule"
        style="@style/AppButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_rule"
        android:layout_marginTop="12dp"
        app:icon="@drawable/ic_plus"
        app:iconGravity="textStart" />
</LinearLayout>
